# systemd USER unit: starts the BeamDash server when you log in.
# It runs as your user (not root) so "Now playing" can see your desktop's media players.
# 1. Change the two /home/YOU/BeamDash paths below to where the folder is.
# 2. mkdir -p ~/.config/systemd/user && cp beamdash.service ~/.config/systemd/user/
# 3. systemctl --user daemon-reload && systemctl --user enable --now beamdash
# Logs: journalctl --user -u beamdash -f      Stop: systemctl --user stop beamdash
[Unit]
Description=BeamDash gauge cluster server for BeamNG.drive
After=graphical-session.target

[Service]
WorkingDirectory=/home/YOU/BeamDash
# add e.g. --game-host 192.168.1.60 if BeamNG runs on a different machine
ExecStart=/usr/bin/env node /home/YOU/BeamDash/server/server.js --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
