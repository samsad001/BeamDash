# systemd unit: runs the BeamDash server at boot.
# 1. Edit User= and the two /opt/BeamDash paths below to match where you copied the folder.
# 2. sudo cp beamdash.service /etc/systemd/system/
# 3. sudo systemctl daemon-reload && sudo systemctl enable --now beamdash
# Logs: journalctl -u beamdash -f
[Unit]
Description=BeamDash gauge cluster server for BeamNG.drive
After=network-online.target
Wants=network-online.target

[Service]
User=YOUR_USER
WorkingDirectory=/opt/BeamDash
# add e.g. --game-host 192.168.1.60 if BeamNG runs on a different machine
ExecStart=/usr/bin/env node /opt/BeamDash/server/server.js --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
